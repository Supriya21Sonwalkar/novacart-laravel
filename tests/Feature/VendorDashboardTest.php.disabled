<?php
namespace Tests\Feature;
use Tests\TestCase;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Str;
use App\Vendor;
use App\User;
use App\Product;
use App\PurchaseOrder;
use App\Order;
use App\StoreRecord;
use App\Services\BatchStock;
use App\Services\CustomerProfile;
class VendorDashboardTest extends TestCase {
 use RefreshDatabase;
 private $a,$b,$pa,$pb;
 protected function setUp():void{parent::setUp();$this->seed(\StoreSeeder::class);$this->a=$this->makeVendor('Alpha');$this->b=$this->makeVendor('Beta');$this->pa=$this->makeProduct($this->a,'Alpha private product');$this->pb=$this->makeProduct($this->b,'Beta private product');$this->actingAs($this->a->user);}
 private function makeVendor($name){$u=User::create(['name'=>$name.' vendor','email'=>strtolower($name).'@vendor.test','password'=>Hash::make('VendorPass123!')]);$u->role_id=DB::table('roles')->where('name','vendor')->value('id');$u->save();return Vendor::create(['name'=>$name.' store','user_id'=>$u->id,'active'=>true,'data'=>['commission_percent'=>10,'email'=>$u->email]]);}
 private function makeProduct($vendor,$name){return Product::create(['name'=>$name,'sku'=>'V-'.$vendor->id,'vendor_id'=>$vendor->id,'category_id'=>Product::first()->category_id,'price'=>10000,'old_price'=>12000,'stock'=>0,'active'=>true,'variants'=>'Default','low_stock_threshold'=>5,'delivery_type'=>'standard','delivery_minutes'=>60]);}
 private function receive($p,$quantity,$batch){DB::transaction(function()use($p,$quantity,$batch){$p->refresh();BatchStock::receive($p,$quantity,['batch_number'=>$batch,'received_at'=>today()->subDay(),'expires_on'=>today()->addDays(30)->toDateString(),'unit_cost'=>5000]);});}
 private function buyer(){ $u=User::create(['name'=>'Customer','email'=>'customer@test.example','password'=>Hash::make('CustomerPass123!')]);$u->role_id=DB::table('roles')->where('name','customer')->value('id');$u->save();CustomerProfile::save($u,['name'=>$u->name,'email'=>$u->email,'phone'=>'98'.str_pad($u->id,8,'0',STR_PAD_LEFT),'address'=>'12 Test Road','city'=>'Mumbai','state'=>'Maharashtra','pincode'=>'400001']);$this->actingAs($u);return $u; }
 private function place($products){$u=$this->buyer();foreach($products as $p)$this->post('/cart/add/'.$p->id,['quantity'=>2,'variant'=>'Default'])->assertSessionHasNoErrors();$this->post('/checkout',['key'=>(string)Str::uuid(),'address_id'=>DB::table('addresses')->where('user_id',$u->id)->value('id'),'shipping_id'=>StoreRecord::in('shipping_methods')->first()->id,'email'=>$u->email,'payment'=>'Test card / UPI'])->assertSessionHasNoErrors();return Order::latest('id')->firstOrFail();}
 private function admin(){$this->actingAs(User::where('email','admin@novacart.test')->first());}
 public function test_all_vendor_pages_render_and_admin_access_is_denied(){foreach(['/vendor','/vendor/products','/vendor/products/create','/vendor/products/'.$this->pa->id.'/edit','/vendor/inventory','/vendor/orders','/vendor/categories','/vendor/analytics','/vendor/payments','/vendor/shipping','/vendor/reviews','/vendor/notifications','/vendor/profile','/vendor/settings'] as $url)$this->get($url)->assertOk();$this->get('/admin')->assertForbidden();$this->get('/admin/orders')->assertForbidden();$this->get('/vendor/products')->assertSee('Alpha private product')->assertDontSee('Beta private product');$this->get('/vendor/products/'.$this->pb->id.'/edit')->assertNotFound();$this->post('/vendor/products/'.$this->pb->id.'/deactivate')->assertNotFound();auth()->logout();$this->get('/vendor')->assertRedirect('/vendor/login');}
 public function test_vendor_login_redirects_without_customer_profile_and_inactive_store_is_blocked(){auth()->logout();$this->post('/vendor/login',['email'=>$this->a->user->email,'password'=>'VendorPass123!'])->assertRedirect('/vendor');$this->a->update(['active'=>false]);$this->get('/vendor')->assertForbidden();auth()->logout();$this->post('/vendor/login',['email'=>$this->a->user->email,'password'=>'VendorPass123!'])->assertSessionHasErrors('email');}
 public function test_product_crud_ignores_forged_owner_and_stock_and_checks_category(){
  $input=['name'=>'Vendor new item','sku'=>'V-NEW','price'=>'12.75','old_price'=>15,'category_id'=>$this->pa->category_id,'low_stock_threshold'=>3,'delivery_type'=>'standard','delivery_minutes'=>60,'active'=>1,'vendor_id'=>$this->b->id,'stock'=>999];$this->post('/vendor/products',$input)->assertSessionHasNoErrors();$p=Product::where('sku','V-NEW')->firstOrFail();$this->assertEquals($this->a->id,$p->vendor_id);$this->assertEquals(0,$p->stock);$this->assertEquals(1275,$p->price);$this->post('/vendor/products/'.$p->id.'/deactivate')->assertSessionHasNoErrors();$this->assertFalse($p->fresh()->active);
  $sub=\App\Subcategory::create(['name'=>'Wrong subcategory','category_id'=>StoreRecord::in('categories')->where('id','!=',$this->pa->category_id)->value('id'),'active'=>true]);$input['sku']='BAD-SUB';$input['subcategory_id']=$sub->id;$this->post('/vendor/products',$input)->assertSessionHasErrors('store');
 }
 public function test_stock_request_needs_admin_receipt_and_cannot_be_received_twice(){
  $payload=['request_key'=>(string)Str::uuid(),'product_id'=>$this->pa->id,'quantity'=>5,'batch_number'=>'VENDOR-101','unit_cost'=>'50.25','invoice_number'=>'V-BILL-1','reason'=>'Goods delivered for inspection','expires_on'=>today()->addDays(20)->toDateString()];$this->post('/vendor/inventory/requests',$payload)->assertSessionHasNoErrors();$this->assertEquals(0,$this->pa->fresh()->stock);$id=DB::table('vendor_stock_requests')->value('id');$this->post('/admin/vendor-stock-requests/'.$id,['action'=>'approve','review_notes'=>'Inspected goods'])->assertForbidden();$this->admin();$this->get('/admin/vendor-stock-requests')->assertOk();$this->post('/admin/vendor-stock-requests/'.$id,['action'=>'approve','review_notes'=>'Inspected goods'])->assertSessionHasNoErrors();$this->assertEquals(5,$this->pa->fresh()->stock);$this->assertEquals(5025,DB::table('product_batches')->where('product_id',$this->pa->id)->value('unit_cost'));$this->assertEquals(1,DB::table('inwards')->count());$this->assertEquals(5,DB::table('inventory')->where('product_id',$this->pa->id)->value('after_quantity'));$this->post('/admin/vendor-stock-requests/'.$id,['action'=>'approve','review_notes'=>'Inspected again'])->assertSessionHasErrors('store');$this->assertEquals(5,$this->pa->fresh()->stock);
 }
 public function test_purchase_supply_and_partial_receipts_connect_without_premature_stock(){
  $po=PurchaseOrder::create(['number'=>'PO-VENDOR-1','request_key'=>(string)Str::uuid(),'vendor_id'=>$this->a->id,'created_by'=>User::where('email','admin@novacart.test')->value('id'),'order_date'=>today()->toDateString()]);$po->items()->create(['product_id'=>$this->pa->id,'name'=>$this->pa->name,'sku'=>$this->pa->sku,'category_name'=>'Test','subcategory_name'=>'Test','existing_stock'=>0,'quantity'=>5]);
  $this->get('/vendor/purchases/'.$po->id)->assertOk();foreach(['accept','processing','ship'] as $action)$this->post('/vendor/purchases/'.$po->id.'/action',['action'=>$action,'carrier'=>'Vendor courier','tracking_number'=>'SUP-123'])->assertSessionHasNoErrors();$this->assertEquals('Shipped',$po->fresh()->supplier_status);$this->assertEquals(0,$this->pa->fresh()->stock);
  $this->admin();$this->get('/admin/inward/create?purchase_order_id='.$po->id)->assertOk()->assertSee('PO-VENDOR-1');$receipt=['number'=>'IN-VENDOR-1','purchase_order_id'=>$po->id,'inward_date'=>today()->toDateString(),'supplier'=>'ignored supplied label','supplier_invoice_no'=>'BILL-PO-1','invoice_date'=>today()->toDateString(),'warehouse'=>'Main inventory','received_by'=>'Admin','items'=>[['product_id'=>$this->pa->id,'batch_number'=>'PO-BATCH-1','quantity'=>2,'unit_cost'=>50,'gst_percent'=>0]]];$this->post('/admin/inward',$receipt)->assertSessionHasNoErrors();$this->assertEquals(2,$this->pa->fresh()->stock);$this->assertEquals('Partially Received',$po->fresh()->status);$this->assertEquals(3,$po->items()->first()->pending_quantity);
  $receipt['number']='IN-VENDOR-2';$receipt['items'][0]['batch_number']='PO-BATCH-2';$receipt['items'][0]['quantity']=4;$this->post('/admin/inward',$receipt)->assertSessionHasErrors('store');$this->assertEquals(2,$this->pa->fresh()->stock);$this->assertEquals(1,DB::table('inwards')->count());$receipt['items'][0]['quantity']=3;$this->post('/admin/inward',$receipt)->assertSessionHasNoErrors();$this->assertEquals('Received',$po->fresh()->status);$this->assertEquals(5,$this->pa->fresh()->stock);$this->assertEquals(0,$po->items()->first()->pending_quantity);$this->actingAs($this->b->user);$this->get('/vendor/purchases/'.$po->id)->assertNotFound();
 }
 public function test_mixed_customer_order_is_scoped_and_fifo_is_deducted_only_once(){
  $this->receive($this->pa,1,'FIFO-FIRST');$this->receive($this->pa,4,'FIFO-SECOND');$this->receive($this->pb,5,'BETA-BATCH');$order=$this->place([$this->pa,$this->pb]);$this->assertEquals(3,$this->pa->fresh()->stock);$this->assertEquals(2,DB::table('vendor_fulfilments')->count());$all=$order->items()->get();$this->assertEquals($order->discount,$all->sum('vendor_discount'));$this->assertEquals($order->tax,$all->sum('vendor_tax'));$this->assertEquals($order->shipping,$all->sum('vendor_shipping'));
  $this->actingAs($this->a->user);$this->get('/vendor/orders/'.$order->id)->assertOk()->assertSee('Alpha private product')->assertDontSee('Beta private product');$this->get('/vendor/orders')->assertOk()->assertDontSee('Beta private product');$this->get('/vendor/analytics')->assertOk();foreach(['accept','processing','ready'] as $action)$this->post('/vendor/orders/'.$order->id.'/action',['action'=>$action])->assertSessionHasNoErrors();$this->post('/vendor/shipping/'.$order->id,['carrier'=>'Alpha courier','tracking_number'=>'A-TRACK'])->assertSessionHasNoErrors();$this->assertEquals('Placed',$order->fresh()->status);$this->assertEquals(3,$this->pa->fresh()->stock);
  $this->admin();$this->get('/orders/'.$order->id)->assertOk()->assertSee('Alpha courier');$this->post('/admin/outward',['request_key'=>(string)Str::uuid(),'type'=>'Order Dispatch','outward_date'=>today()->toDateString(),'source'=>'Main inventory','order_id'=>$order->id,'intent'=>'confirm'])->assertSessionHasNoErrors();$out=\App\Outward::firstOrFail();$this->post('/admin/outward/'.$out->id.'/action',['action'=>'pack'])->assertSessionHasNoErrors();$this->post('/admin/outward/'.$out->id.'/dispatch-details',['partner'=>'Warehouse courier','tracking_number'=>'FULL-TRACK'])->assertSessionHasNoErrors();$this->post('/admin/outward/'.$out->id.'/action',['action'=>'dispatch'])->assertSessionHasNoErrors();$this->assertEquals('Shipped',$order->fresh()->status);$this->assertEquals('Shipped',DB::table('vendor_fulfilments')->where('vendor_id',$this->a->id)->value('status'));$this->assertEquals(3,$this->pa->fresh()->stock);$this->get('/admin/outward/'.$out->id)->assertOk();
 }
 public function test_ownership_snapshot_does_not_grant_historical_orders_when_product_is_reassigned(){
  $this->receive($this->pa,5,'SNAPSHOT');$order=$this->place([$this->pa]);$this->pa->update(['vendor_id'=>$this->b->id]);$this->actingAs($this->b->user);$this->get('/vendor/orders/'.$order->id)->assertNotFound();$this->post('/vendor/orders/'.$order->id.'/action',['action'=>'accept'])->assertNotFound();$this->actingAs($this->a->user);$this->get('/vendor/orders/'.$order->id)->assertOk();
 }
 public function test_review_response_profile_preferences_and_finances_are_scoped(){
  $review=\App\Review::create(['product_id'=>$this->pa->id,'user_id'=>$this->a->user_id,'rating'=>5,'title'=>'Good item','text'=>'Useful review','approved'=>true]);$foreign=\App\Review::create(['product_id'=>$this->pb->id,'user_id'=>$this->b->user_id,'rating'=>1,'title'=>'Private beta review','text'=>'Not visible to alpha','approved'=>true]);$this->get('/vendor/reviews')->assertOk()->assertDontSee('Private beta review');$this->post('/vendor/reviews/'.$foreign->id,['response'=>'Forged response'])->assertNotFound();$this->post('/vendor/reviews/'.$review->id,['response'=>'Thank you','rating'=>1,'text'=>'Tampered review'])->assertSessionHasNoErrors();$this->assertEquals(5,$review->fresh()->rating);$this->assertEquals('Useful review',$review->fresh()->text);
  $this->post('/vendor/profile',['name'=>'Alpha updated','email'=>$this->a->user->email,'commission_percent'=>99,'user_id'=>$this->b->user_id])->assertSessionHasNoErrors();$this->assertEquals(10,$this->a->fresh()->data['commission_percent']);$this->assertEquals($this->a->user_id,$this->a->fresh()->user_id);
  $this->receive($this->pa,5,'EARNINGS');$order=$this->place([$this->pa]);$this->admin();\App\Services\Commerce::status($order,'Delivered',true);$f=\App\Services\VendorFlow::finances($this->a->id);$this->assertEquals(20000,$f['gross']);$this->assertEquals(2000,$f['commission']);$this->assertEquals(18000,$f['net']);$this->assertEquals(0,$f['available']);$this->actingAs($this->b->user);$this->assertEquals(0,\App\Services\VendorFlow::finances($this->b->id)['gross']);$this->get('/vendor/analytics/export')->assertOk()->assertDontSee('Alpha private product');
 }
}
